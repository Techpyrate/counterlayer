# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real secrets.

# ── Firebase (client / Web SDK) ─────────────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only if you use Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (server-only — API routes, SSR) ───────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
# Use the JSON fields below (NOT the whole JSON file in client code).

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Paste the private key from the service account JSON.
# Keep the \n escapes on one line, or wrap in quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Alternative to the three vars above: entire service account JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Pro plan (server) ────────────────────────────────────────────────────────
# Comma-separated Firebase UIDs or emails with Pro access (until Stripe is wired)
PRO_PLAN_USER_IDS=
PRO_PLAN_EMAILS=
# Local dev: bypass Pro auth on compliance APIs
COMPLIANCE_SCAN_DEV_UNLOCK=false
# Max compliance scans per Pro user per day
PRO_DAILY_SCAN_LIMIT=20

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
